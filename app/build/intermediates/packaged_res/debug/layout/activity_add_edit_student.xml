<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark" android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:title="Add Student"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <EditText android:id="@+id/etName" android:hint="Full Name *" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etAge" android:hint="Age" android:inputType="number"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <Spinner android:id="@+id/spGender" android:background="@color/colorCard"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:popupBackground="@color/colorCard" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etCourse" android:hint="Course"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etRegNo" android:hint="Registration Number *"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etEmail" android:hint="Email *" android:inputType="textEmailAddress"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etPhone" android:hint="Phone" android:inputType="phone"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etPassword" android:hint="Password (leave blank to keep)"
                android:inputType="textPassword" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etAmountOwed" android:hint="Amount Owed (KES)"
                android:inputType="numberDecimal" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
            <Button android:id="@+id/btnSave" android:text="Save Student"
                android:layout_width="match_parent" android:layout_height="52dp"
                style="@style/AppButton" android:layout_marginBottom="12dp"/>
            <Button android:id="@+id/btnDelete" android:text="Delete Student"
                android:layout_width="match_parent"
                android:visibility="gone" android:backgroundTint="@color/colorRed"
                android:textColor="@color/white" android:layout_height="wrap_content" android:padding="14dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
