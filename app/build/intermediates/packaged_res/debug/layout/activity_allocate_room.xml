<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark" android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:title="Allocate Room"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:text="SELECT STUDENT" android:textColor="@color/colorMuted" android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spStudent" android:background="@color/colorCard"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:popupBackground="@color/colorCard" android:layout_marginBottom="14dp"/>
            <TextView android:text="SELECT ROOM" android:textColor="@color/colorMuted" android:textSize="11sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spRoom" android:background="@color/colorCard"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:popupBackground="@color/colorCard" android:layout_marginBottom="14dp"/>
            <EditText android:id="@+id/etBedNumber" android:hint="Bed number (default: 1)"
                android:inputType="number" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/>
            <EditText android:id="@+id/etAmountOwed" android:hint="Amount owed (KES) — defaults to room price"
                android:inputType="numberDecimal" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp"/>
            <Button android:id="@+id/btnAllocate" android:text="Allocate Room"
                android:layout_width="match_parent" android:layout_height="52dp" style="@style/AppButton"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
