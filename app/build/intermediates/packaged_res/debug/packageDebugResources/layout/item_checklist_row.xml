<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/colorCard"
    android:layout_marginBottom="6dp" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/cbItem" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/colorText" android:textSize="14sp"
            android:buttonTint="@color/colorGreen"/>
        <Button android:id="@+id/btnAddNote" android:text="+ note"
            android:layout_width="wrap_content" android:layout_height="32dp"
            android:background="@color/colorBorder" android:textColor="@color/colorMuted"
            android:textSize="11sp" android:paddingStart="10dp" android:paddingEnd="10dp"/>
    </LinearLayout>
    <EditText android:id="@+id/etNote" android:hint="Describe condition..."
        android:background="@color/colorSurface" android:textColor="@color/colorText"
        android:textColorHint="@color/colorSub" android:padding="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:visibility="gone"/>
</LinearLayout>
