<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">

        <TextView android:text="Create Account" android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/colorText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="40dp"
            android:layout_marginBottom="4dp"/>
        <TextView android:text="Register as a hostel resident"
            android:textColor="@color/colorMuted" android:textSize="14sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"/>

        <TextView android:text="FULL NAME *" android:textColor="@color/colorMuted"
            android:textSize="11sp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etName" android:hint="e.g. Amina Odhiambo"
            android:background="@color/colorCard" android:textColor="@color/colorText"
            android:textColorHint="@color/colorSub" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="REGISTRATION NUMBER *" android:textColor="@color/colorMuted"
            android:textSize="11sp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etRegNo" android:hint="e.g. SCT/2023/001"
            android:background="@color/colorCard" android:textColor="@color/colorText"
            android:textColorHint="@color/colorSub" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="PHONE NUMBER *" android:textColor="@color/colorMuted"
            android:textSize="11sp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etPhone" android:hint="+60 12 345 6789"
            android:inputType="phone" android:background="@color/colorCard"
            android:textColor="@color/colorText" android:textColorHint="@color/colorSub"
            android:padding="14dp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

        <TextView android:text="EMAIL *" android:textColor="@color/colorMuted"
            android:textSize="11sp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etEmail" android:hint="you@univ.ac"
            android:inputType="textEmailAddress" android:background="@color/colorCard"
            android:textColor="@color/colorText" android:textColorHint="@color/colorSub"
            android:padding="14dp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>

        <TextView android:text="AGE" android:textColor="@color/colorMuted" android:textSize="11sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etAge" android:hint="e.g. 20" android:inputType="number"
            android:background="@color/colorCard" android:textColor="@color/colorText"
            android:textColorHint="@color/colorSub" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="GENDER" android:textColor="@color/colorMuted" android:textSize="11sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spGender" android:background="@color/colorCard"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:popupBackground="@color/colorCard" android:layout_marginBottom="16dp"/>

        <TextView android:text="COURSE" android:textColor="@color/colorMuted" android:textSize="11sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etCourse" android:hint="e.g. BSc Computer Science"
            android:background="@color/colorCard" android:textColor="@color/colorText"
            android:textColorHint="@color/colorSub" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="PASSWORD *" android:textColor="@color/colorMuted"
            android:textSize="11sp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etPassword" android:hint="Choose a strong password"
            android:inputType="textPassword" android:background="@color/colorCard"
            android:textColor="@color/colorText" android:textColorHint="@color/colorSub"
            android:padding="14dp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="24dp"/>

        <ProgressBar android:id="@+id/progressBar" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnRegister" android:text="Create Account"
            android:layout_width="match_parent" android:layout_height="52dp"
            style="@style/AppButton" android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/tvLogin" android:text="Already have an account? Log in"
            android:textColor="@color/colorAccent" android:textSize="14sp" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
