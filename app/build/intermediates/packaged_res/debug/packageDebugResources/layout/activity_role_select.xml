<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark" android:gravity="center"
    android:orientation="vertical" android:padding="32dp">
    <TextView android:text="🏫" android:textSize="64sp" android:gravity="center"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="HostelMS" android:textSize="36sp" android:textStyle="bold"
        android:textColor="@color/colorText" android:gravity="center"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <TextView android:text="Select your role to continue"
        android:textColor="@color/colorMuted" android:textSize="15sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginBottom="48dp"/>
    <Button android:id="@+id/btnStudent" android:text="👤  Student Login / Register"
        android:layout_width="280dp" android:layout_height="56dp"
        style="@style/AppButton" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnAdmin" android:text="🛡️  Administrator Login"
        android:layout_width="280dp" android:layout_height="56dp"
        style="@style/AppButtonOutline"/>
</LinearLayout>
