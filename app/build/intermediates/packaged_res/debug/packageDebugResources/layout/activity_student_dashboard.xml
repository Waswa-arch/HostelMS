<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark" android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- Welcome Banner -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="20dp"
                app:cardCornerRadius="10dp" app:cardBackgroundColor="#1e3a5f">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:text="WELCOME BACK" android:textColor="@color/colorAccent"
                        android:textSize="11sp" android:letterSpacing="0.15"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvWelcome" android:text="Hello 👋"
                        android:textSize="22sp" android:textStyle="bold" android:textColor="@color/colorText"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tvRegNo" android:text=""
                        android:textSize="13sp" android:textColor="@color/colorMuted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:text="Quick Actions" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/colorText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

            <!-- Row 1: Booking + Inquiry -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <androidx.cardview.widget.CardView android:id="@+id/cardBooking"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="🏨" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Booking" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardInquiry"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="🔍" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Inquiry" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Row 2: Complaints + Announcements -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <androidx.cardview.widget.CardView android:id="@+id/cardComplaints"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="📢" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Issues" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardAnnouncements"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="📋" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Notices" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Row 3: FAQ + How to Use -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <androidx.cardview.widget.CardView android:id="@+id/cardFaq"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="❓" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="FAQ" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardHowToUse"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="📖" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="How to Use" android:textColor="@color/colorText" android:textSize="11sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Row 4: Check-In + QR Scan + Profile (original features retained) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <androidx.cardview.widget.CardView android:id="@+id/cardCheckin"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="✅" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Check-In" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardQrScan"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="📷" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Scan QR" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/cardProfile"
                    android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" app:cardCornerRadius="10dp" app:cardBackgroundColor="@color/colorCard">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:orientation="vertical" android:gravity="center" android:padding="10dp">
                        <TextView android:text="👤" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Profile" android:textColor="@color/colorText" android:textSize="12sp"
                            android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
