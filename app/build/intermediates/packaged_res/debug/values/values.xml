<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#000000</color>
    <color name="colorAccent">#F59E0B</color>
    <color name="colorBackground">#0F172A</color>
    <color name="colorBlue">#3B82F6</color>
    <color name="colorBorder">#243044</color>
    <color name="colorCard">#1A2235</color>
    <color name="colorGreen">#10B981</color>
    <color name="colorMuted">#94A3B8</color>
    <color name="colorPrimary">#1A2235</color>
    <color name="colorPrimaryDark">#0A0F1E</color>
    <color name="colorRed">#EF4444</color>
    <color name="colorSub">#64748B</color>
    <color name="colorSurface">#111827</color>
    <color name="colorText">#F1F5F9</color>
    <color name="colorTextPrimary">#F1F5F9</color>
    <color name="colorTextSecondary">#94A3B8</color>
    <color name="white">#FFFFFF</color>
    <dimen name="card_radius">10dp</dimen>
    <dimen name="margin_large">24dp</dimen>
    <dimen name="margin_medium">16dp</dimen>
    <dimen name="margin_small">8dp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_small">13sp</dimen>
    <dimen name="text_title">22sp</dimen>
    <string name="app_name">HostelMS</string>
    <string name="tagline">Your home, managed.</string>
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">6dp</item>
    </style>
    <style name="AppButtonOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/colorAccent</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="cornerRadius">6dp</item>
    </style>
    <style name="CardStyle" parent="">
        <item name="android:background">@color/colorCard</item>
    </style>
    <style name="Theme.HostelMS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorPrimaryDark</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>
    <style name="Theme.HostelMS.Splash" parent="Theme.HostelMS">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>