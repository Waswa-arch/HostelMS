<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient - deep blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0d2137"
                android:endColor="#1a3a5c"
                android:angle="135"/>
        </shape>
    </item>
    <!-- Roof triangle -->
    <item android:top="20dp" android:left="40dp" android:right="40dp" android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#F59E0B"/>
        </shape>
    </item>
    <!-- Main building body -->
    <item android:top="50dp" android:left="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#e8d5b0"/>
            <corners android:topLeftRadius="2dp" android:topRightRadius="2dp"/>
        </shape>
    </item>
    <!-- Window row 1 left -->
    <item android:top="65dp" android:left="35dp" android:right="115dp" android:bottom="105dp">
        <shape android:shape="rectangle">
            <solid android:color="#1a3a5c"/>
        </shape>
    </item>
    <!-- Window row 1 right -->
    <item android:top="65dp" android:left="115dp" android:right="35dp" android:bottom="105dp">
        <shape android:shape="rectangle">
            <solid android:color="#1a3a5c"/>
        </shape>
    </item>
    <!-- Door -->
    <item android:top="100dp" android:left="65dp" android:right="65dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#8B4513"/>
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"/>
        </shape>
    </item>
</layer-list>
