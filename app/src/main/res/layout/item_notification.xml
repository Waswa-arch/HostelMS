<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="14dp"
    android:layout_marginBottom="8dp" android:gravity="center_vertical"
    android:background="@color/colorCard">

    <!-- Icon -->
    <TextView android:id="@+id/tvIcon" android:textSize="28sp"
        android:layout_width="44dp" android:layout_height="44dp"
        android:gravity="center" android:layout_marginEnd="12dp"/>

    <!-- Text -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTitle" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/colorText"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvBody" android:textSize="13sp"
            android:textColor="@color/colorMuted" android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvTime" android:textSize="11sp"
            android:textColor="@color/colorSub" android:layout_marginTop="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
