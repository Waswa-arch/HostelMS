<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark" android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:title="Add Room"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <EditText android:id="@+id/etHostel" android:hint="Hostel Name *"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etRoomNumber" android:hint="Room Number e.g. 101"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <Spinner android:id="@+id/spRoomType" android:background="@color/colorCard"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:popupBackground="@color/colorCard" android:layout_marginBottom="10dp"/>
            <Spinner android:id="@+id/spGender" android:background="@color/colorCard"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:popupBackground="@color/colorCard" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etCapacity" android:hint="Capacity (persons)"
                android:inputType="number" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etPrice" android:hint="Price per Semester (KES)"
                android:inputType="numberDecimal" android:background="@color/colorCard"
                android:textColor="@color/colorText" android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <EditText android:id="@+id/etAmenities" android:hint="Amenities (e.g. Wi-Fi, Laundry)"
                android:background="@color/colorCard" android:textColor="@color/colorText"
                android:textColorHint="@color/colorSub" android:padding="12dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
            <Spinner android:id="@+id/spStatus" android:background="@color/colorCard"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:popupBackground="@color/colorCard" android:layout_marginBottom="20dp"/>
            <Button android:id="@+id/btnSave" android:text="Save Room"
                android:layout_width="match_parent" android:layout_height="52dp"
                style="@style/AppButton" android:layout_marginBottom="12dp"/>
            <Button android:id="@+id/btnDelete" android:text="Delete Room"
                android:visibility="gone" android:backgroundTint="@color/colorRed"
                android:textColor="@color/white" android:padding="14dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
